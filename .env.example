# Copy this file to .env and fill in your own values.
# VITE_ prefix is required so Vite exposes these keys to the client bundle.

# Firebase Project Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Google OAuth 2.0 Client IDs (from Google Cloud Console)
VITE_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
